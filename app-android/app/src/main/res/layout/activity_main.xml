<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACast 手机投屏端"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_ready"
        android:textColor="#4CAF50"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_toggle_capture"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/btn_start_capture"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_toggle_camera"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="📷 启用 Android 摄像头 (Mac 虚拟摄像头)"
        android:backgroundTint="#2196F3"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/layout_camera_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_switch_camera"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="🔄 翻转"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_toggle_torch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="💡 补光灯"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_camera_res"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="⚙️ 1080P" />
    </LinearLayout>

    <TextureView
        android:id="@+id/camera_preview_view"
        android:layout_width="160dp"
        android:layout_height="100dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_accessibility"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="🖱️ 电脑鼠标反控：检测中..."
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_scan_tv"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/btn_scan_dlna"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btn_check_update"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="检查并直接在线更新"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_device_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. 选择目标设备 (💻 电脑控制端 / 📺 大屏电视):"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/lv_devices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
